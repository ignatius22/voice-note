{
  "name": "vault-notes",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "mobile": "pnpm --filter @vault/mobile start",
    "mobile:start": "pnpm --filter @vault/mobile start",
    "mobile:android": "pnpm --filter @vault/mobile android",
    "mobile:ios": "pnpm --filter @vault/mobile ios",
    "control-plane": "pnpm --filter @vault/control-plane dev",
    "control-plane:dev": "pnpm --filter @vault/control-plane dev",
    "release:ota:staging": "echo OTA release script placeholder",
    "release:ota:production": "echo OTA release script placeholder"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
